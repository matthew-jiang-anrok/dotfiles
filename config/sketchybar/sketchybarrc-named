#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Gruvbox Dark color scheme + AeroSpace workspace integration

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Gruvbox Dark palette ──────────────────────────────────────────────────────
# bg0:     0xff282828   bg0_h:   0xff1d2021   bg2:      0xff504945
# fg:      0xffebdbb2   fg4:     0xffa89984   gray:     0xff928374
# purple:  0xffd3869b   blue:    0xff83a598   aqua:     0xff8ec07c
# green:   0xffb8bb26   yellow:  0xfffabd2f   red:      0xfffb4934
# orange:  0xfffe8019

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top          \
    height=36             \
    margin=8              \
    y_offset=4            \
    corner_radius=10      \
    blur_radius=20        \
    color=0xcc282828      \
    border_width=1        \
    border_color=0x44cdd6f4 \
    shadow=on             \
    topmost=window        \
    padding_left=12       \
    padding_right=12

# ── Global item defaults ──────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4                              \
    padding_right=4                             \
    icon.font="Hack Nerd Font:Bold:15.0"     \
    label.font="Hack Nerd Font:Bold:13.0"    \
    icon.color=0xffebdbb2                       \
    label.color=0xffebdbb2                      \
    icon.padding_left=6                         \
    icon.padding_right=4                        \
    label.padding_left=4                        \
    label.padding_right=6

# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
sketchybar --add event aerospace_workspace_change

# _ws_item <id> <label> <color>
_ws_item() {
    local sid="$1" label="$2" color="$3"
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
            background.color=0x00000000              \
            background.corner_radius=6               \
            background.height=24                     \
            background.drawing=off                   \
            label="$label"                           \
            label.font="Hack Nerd Font:Bold:12.0" \
            label.color=$color                       \
            icon.drawing=off                         \
            padding_left=3                           \
            padding_right=3                          \
            click_script="aerospace workspace $sid"  \
            script="$PLUGIN_DIR/aerospace.sh $sid $color"
}

_ws_item D "[D]ev"       0xff83a598
_ws_item W "[W]eb"       0xff8ec07c
_ws_item M "[M]essaging" 0xffb8bb26
_ws_item E "[E]mail"     0xfffabd2f
_ws_item S "[S]cratch"   0xffd3869b

# Group workspace items under a shared background pill
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color=0x33313244     \
        background.corner_radius=8      \
        background.height=28            \
        background.border_width=1       \
        background.border_color=0x33cdd6f4

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="Hack Nerd Font:Bold:13.0"            \
        label.color=0xffa89984                              \
        padding_left=10                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color=0xff83a598       \
        icon.padding_left=0         \
        label.color=0xffebdbb2      \
        padding_left=4              \
        padding_right=4             \
        update_freq=10              \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color=0xffebdbb2      \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color=0xffebdbb2      \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ───────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                   \
        icon.font="Hack Nerd Font:Bold:15.0" \
        icon.color=0xffb8bb26       \
        label.color=0xffebdbb2      \
        update_freq=10              \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color=0xffebdbb2      \
        update_freq=10              \
        script="$PLUGIN_DIR/memory.sh"

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
